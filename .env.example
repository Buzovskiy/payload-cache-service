APP_NAME=Payload Cache Service
DEBUG=false
API_PORT=8005
# PostgreSQL host port. Use DB_PORT=5435 if 5432 is occupied.
DB_PORT=5432
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=payload_cache
# Used by local uv / Alembic; overridden to db inside Compose.
DB_HOST=localhost
PAYLOAD_DIRECTORY=./data/payloads
